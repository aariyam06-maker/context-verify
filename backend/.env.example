# Production MUST set a random secret; development fallback is only for local testing.
CTXTRACE_SECRET_KEY=replace-with-a-32-byte-random-secret
CTXTRACE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/contexttrace.db
CTXTRACE_COOKIE_SECURE=false
CTXTRACE_MAX_UPLOAD_MB=500
CTXTRACE_AI_SAMPLE_FPS=1.0
CTXTRACE_AI_MAX_FRAMES=96
CTXTRACE_DETECTOR_PROFILE=research_ensemble
CTXTRACE_PRIMARY_MODEL=Ant-One/GenD_DINOv3_L_FF
CTXTRACE_SECONDARY_MODEL=dima806/deepfake_vs_real_image_detection
# Optional YuNet face detector ONNX:
# CTXTRACE_YUNET_MODEL=./data/models/face_detection_yunet_2023mar.onnx
# Installed only after project-specific calibration:
# CTXTRACE_CALIBRATION_PATH=./data/models/ai_calibration.json
