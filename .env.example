# Production MUST set a random secret; the development fallback is only for local use.
CTXTRACE_SECRET_KEY=replace-with-a-32-byte-random-secret
# start.py always adds http://localhost:3000 and :3751
CTXTRACE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Default: SQLite in data/contexttrace.db. For Postgres:
# DATABASE_URL=postgresql+psycopg://contexttrace:contexttrace@localhost:5432/contexttrace
CTXTRACE_COOKIE_SECURE=false
CTXTRACE_MAX_UPLOAD_MB=500
# Seconds of each video analysed / frames sampled by the AI detector
CTXTRACE_MAX_SECONDS=10
CTXTRACE_AI_FRAMES=16
# Demo accounts (demo@contexttrace.app, admin@contexttrace.app); set false in production
CTXTRACE_DEMO=true
# Optional free Gemini second opinion
# GEMINI_API_KEY=
# CTXTRACE_GEMINI_MODEL=gemini-2.5-flash
# CTXTRACE_GEMINI_WEIGHT=0.25
